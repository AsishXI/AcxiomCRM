@model List<AcxiomCRM.Models.Customer>
@{ ViewData["Title"] = "Customers"; }
<h2>Customers</h2>
@if (TempData["Msg"] != null) { <div class="alert alert-success">@TempData["Msg"]</div> }
<form method="get" class="row g-2 mb-3">
    <div class="col-md-5"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search name, email, phone, company" /></div>
    <div class="col-md-3">
        <select name="status" class="form-select">
            <option value="">All statuses</option>
            <option selected="@(ViewBag.Status == "Active")">Active</option>
            <option selected="@(ViewBag.Status == "Inactive")">Inactive</option>
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-primary">Search</button> <a asp-action="Index" class="btn btn-outline-secondary">Reset</a></div>
    <div class="col text-end"><a asp-action="Create" class="btn btn-success">+ New Customer</a></div>
</form>
<table class="table table-striped">
    <thead><tr><th>Code</th><th>Name</th><th>Email</th><th>Phone</th><th>Company</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.CustomerCode</td><td>@c.CustomerName</td><td>@c.Email</td><td>@c.Phone</td><td>@c.CompanyName</td><td>@c.Status</td>
            <td class="text-end">
                <a asp-action="Details" asp-route-id="@c.CustomerId" class="btn btn-sm btn-info">Details</a>
                <a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn btn-sm btn-warning">Edit</a>
                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    <form asp-action="Delete" asp-route-id="@c.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Delete this customer?');">
                        <button class="btn btn-sm btn-danger">Delete</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
@{ int pg = ViewBag.Page; int pgs = ViewBag.Pages; }
<nav>
    <ul class="pagination">
        <li class="page-item @(pg == 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(pg - 1)" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status">Previous</a>
        </li>
        @for (int i = 1; i <= pgs; i++)
        {
            <li class="page-item @(i == pg ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status">@i</a>
            </li>
        }
        <li class="page-item @(pg == pgs ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(pg + 1)" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status">Next</a>
        </li>
    </ul>
</nav>