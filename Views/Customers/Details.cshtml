@model AcxiomCRM.Models.Customer
@{ ViewData["Title"] = "Customer Details"; }
<h2>@Model.CustomerName</h2>
<dl class="row">
    <dt class="col-sm-3">Code</dt><dd class="col-sm-9">@Model.CustomerCode</dd>
    <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd>
    <dt class="col-sm-3">Company</dt><dd class="col-sm-9">@Model.CompanyName</dd>
    <dt class="col-sm-3">Address</dt><dd class="col-sm-9">@Model.Address, @Model.City, @Model.State</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
    <dt class="col-sm-3">Created</dt><dd class="col-sm-9">@Model.CreatedDate (by @Model.CreatedBy)</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>