@model AcxiomCRM.Models.Customer
@{ ViewData["Title"] = "Edit Customer"; }
<h2>Edit Customer</h2>
<form asp-action="Edit" asp-route-id="@Model.CustomerId" method="post">
    <partial name="_Form" model="Model" />
    <button class="btn btn-primary">Update</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }