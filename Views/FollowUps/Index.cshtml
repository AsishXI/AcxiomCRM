@model List<AcxiomCRM.Models.FollowUp>
@{ ViewData["Title"] = "Follow-Ups"; }
<h2>Follow-Ups</h2>
@if (TempData["Msg"] != null) { <div class="alert alert-info">@TempData["Msg"]</div> }
<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Customer or assigned user" /></div>
    <div class="col-md-2"><select name="status" class="form-select" asp-items="@((SelectList)ViewBag.Statuses)"><option value="">All statuses</option></select></div>
    <div class="col-md-2"><input type="date" name="date" value="@(((DateTime?)ViewBag.Date)?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
    <div class="col-auto"><button class="btn btn-primary">Search</button> <a asp-action="Index" class="btn btn-outline-secondary">Reset</a></div>
    <div class="col text-end"><a asp-action="Create" class="btn btn-success">+ Schedule Follow-Up</a></div>
</form>
<table class="table table-striped">
    <thead><tr><th>Date</th><th>Customer</th><th>Type</th><th>Status</th><th>Remarks</th><th>Assigned</th><th></th></tr></thead>
    <tbody>
    @foreach (var f in Model)
    {
        bool overdue = f.Status == "Planned" && f.FollowUpDate.Date < DateTime.Today;
        <tr class="@(overdue ? "table-danger" : "")">
            <td>@f.FollowUpDate.ToString("dd MMM yyyy")@(overdue ? " (overdue)" : "")</td><td>@f.Customer?.CustomerName</td><td>@f.FollowUpType</td><td>@f.Status</td><td>@f.Remarks</td><td>@f.AssignedTo</td>
            <td class="text-end">
                @if (f.Status == "Planned") { <form asp-action="Complete" asp-route-id="@f.FollowUpId" method="post" class="d-inline"><button class="btn btn-sm btn-success">Complete</button></form> }
                <a asp-action="Edit" asp-route-id="@f.FollowUpId" class="btn btn-sm btn-warning">Edit</a>
                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                { <form asp-action="Delete" asp-route-id="@f.FollowUpId" method="post" class="d-inline" onsubmit="return confirm('Delete this follow-up?');"><button class="btn btn-sm btn-danger">Delete</button></form> }
            </td>
        </tr>
    }
    </tbody>
</table>