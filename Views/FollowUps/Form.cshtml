@model AcxiomCRM.Models.FollowUp
@{ ViewData["Title"] = "Follow-Up"; }
<h2>Follow-Up</h2>
<form method="post" asp-antiforgery="true">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row">
        <div class="col-md-6 mb-3"><label asp-for="CustomerId" class="form-label"></label>
            <select asp-for="CustomerId" asp-items="@((SelectList)ViewBag.Customers)" class="form-select"><option value="">-- select customer --</option></select>
            <span asp-validation-for="CustomerId" class="text-danger"></span></div>
        <div class="col-md-3 mb-3"><label asp-for="FollowUpDate" class="form-label"></label><input asp-for="FollowUpDate" type="date" class="form-control" /><span asp-validation-for="FollowUpDate" class="text-danger"></span></div>
        <div class="col-md-3 mb-3"><label asp-for="FollowUpType" class="form-label"></label>
            <select asp-for="FollowUpType" class="form-select"><option>Call</option><option>Meeting</option><option>Email</option><option>Task</option></select></div>
        <div class="col-md-3 mb-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="@((SelectList)ViewBag.Statuses)" class="form-select"></select><span asp-validation-for="Status" class="text-danger"></span></div>
        <div class="col-md-9 mb-3"><label asp-for="Remarks" class="form-label"></label><input asp-for="Remarks" class="form-control" /></div>
    </div>
    <button class="btn btn-primary">Save</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }